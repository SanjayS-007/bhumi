# Copy to .env. Defaults below match the locked-down laptop (sqlite profile).
BHUMI_PROFILE=sqlite
BHUMI_OFFLINE=false
BHUMI_DATA_DIR=data
BHUMI_SQLITE_PATH=data/bhumi.db
BHUMI_POSTGRES_URL=
BHUMI_VECTOR_BACKEND=auto
BHUMI_TEXT_BACKEND=auto
BHUMI_GRAPH_BACKEND=auto
BHUMI_BLOB_BACKEND=auto
BHUMI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BHUMI_ENABLE_TIER2=true
BHUMI_ENABLE_TIER3=false
BHUMI_OCR_CONFIDENCE_FLOOR=0.80
