# Copy to .env. Defaults below match the locked-down laptop (sqlite profile).
BHUMI_PROFILE=sqlite
BHUMI_OFFLINE=false
BHUMI_DATA_DIR=data
BHUMI_SQLITE_PATH=data/bhumi.db
BHUMI_POSTGRES_URL=
BHUMI_VECTOR_BACKEND=auto
BHUMI_TEXT_BACKEND=auto
BHUMI_GRAPH_BACKEND=auto
BHUMI_BLOB_BACKEND=auto
BHUMI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BHUMI_ENABLE_TIER2=true
BHUMI_ENABLE_TIER3=false
BHUMI_OCR_CONFIDENCE_FLOOR=0.80

# --- Model backends (rerank / entailment / narrative) ---
# Global default: auto (cascade Azure -> Gemini -> Groq -> deterministic,
# skipping any not configured), a specific name ("azure"|"gemini"|"groq"),
# or "deterministic"/"local"/"none" to disable API calls entirely.
BHUMI_MODEL_BACKEND=auto
# Optional per-capability overrides, checked before BHUMI_MODEL_BACKEND.
# BHUMI_BACKEND_NARRATIVE=gemini
# BHUMI_BACKEND_ENTAILMENT=groq
# BHUMI_BACKEND_RERANK=azure
# Run `uv run task models` to see what actually resolved, and why.

GEMINI_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_TEXT_DEPLOYMENT=
